{
  "name": "hdt-traceability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "icon": "public/icono_yne.png",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "clean": "node -e \"import('fs').then(m=>m.rmSync('release',{recursive:true,force:true})).catch(()=>{})\"",
    "dist": "pnpm clean && pnpm build && electron-builder --win",
    "start": "electron .",
    "preview": "vite preview"
  },
  "dependencies": {
    "ethernet-ip": "^2.0.0",
    "pg": "^8.16.3",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^3.0.5"
  },
  "build": {
    "appId": "com.hdt.traceability",
    "productName": "HDT Traceability",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "config.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icono_yne.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
